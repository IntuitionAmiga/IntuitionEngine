-- CRT-Guest-Advanced F7 acceptance fixture for ted_121_colors_68k.ie68.
-- Launch the binary on the command line: cpu.load() would reset the already-
-- started guest and hides startup failures from this probe.
-- Run:
--   IE_NO_IPC=1 go run . -script sdk/examples/prebuilt/diag_crt_ted.ies \
--     sdk/examples/prebuilt/ted_121_colors_68k.ie68

-- The PNGs are compositor evidence and the MP4 is the final presented image.
local capture = "diag_crt_ted.mp4"
rec.start_screen(capture)
sys.wait_frames(60)

local function phase(expected, name)
    local actual = video.is_crt_enabled()
    if actual ~= expected then
        error(string.format("CRT state at %s = %s, want %s", name, tostring(actual), tostring(expected)))
    end
    sys.print(string.format("CRT_TED_%s enabled=%s compositor_hash=0x%X", name, tostring(actual), video.frame_hash()))
    rec.screenshot("diag_crt_ted_" .. string.lower(name) .. ".png")
    rec.screenshot_screen("diag_crt_ted_screen_" .. string.lower(name) .. ".png")
end

phase(true, "INITIAL")
video.toggle_crt()
sys.wait_frames(60)
phase(false, "F7_OFF_1")
video.toggle_crt()
sys.wait_frames(60)
phase(true, "F7_ON_2")
video.toggle_crt()
sys.wait_frames(60)
phase(false, "F7_OFF_3")
video.toggle_crt()
sys.wait_frames(60)
phase(true, "F7_ON_4")

local w, h = video.get_dimensions()
local hash = video.frame_hash()
sys.print(string.format("CRT_TED_FRAME size=%dx%d hash=0x%X", w, h, hash))

dbg.open()
for _, line in ipairs(dbg.command_output("r")) do
    sys.print("CRT_TED_IEMON " .. tostring(line.text or line))
end
dbg.close()

rec.stop()
sys.print("CRT_TED_PRESENTATION=" .. capture)
sys.exit(0)
