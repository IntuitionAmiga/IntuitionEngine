-- CRT-Guest-Advanced F7 acceptance fixture for rotozoomer_ie64.ie64.
-- Keep this script beside the launched binary:
--   IE_NO_IPC=1 go run . -script sdk/examples/prebuilt/diag_crt_rotozoomer.ies \
--     sdk/examples/prebuilt/rotozoomer_ie64.ie64
--
-- The PNGs are compositor evidence and the MP4 is the final presented image.
local capture = "diag_crt_rotozoomer.mp4"

rec.start_screen(capture)
sys.wait_frames(60)

local function phase(expected, name)
    local actual = video.is_crt_enabled()
    if actual ~= expected then
        error(string.format("CRT state at %s = %s, want %s", name, tostring(actual), tostring(expected)))
    end
    sys.print(string.format("CRT_ROTOZOOMER_%s enabled=%s compositor_hash=0x%X", name, tostring(actual), video.frame_hash()))
    rec.screenshot("diag_crt_rotozoomer_" .. string.lower(name) .. ".png")
    rec.screenshot_composed("diag_crt_rotozoomer_composed_" .. string.lower(name) .. ".png")
    rec.screenshot_screen("diag_crt_rotozoomer_screen_" .. string.lower(name) .. ".png")
end

phase(true, "INITIAL")
-- Match a physical F7: it changes the host presentation and is also offered
-- to the guest keyboard path during the same host input cycle.
video.toggle_crt()
term.key_press(keys.F7)
sys.wait_frames(60)
phase(false, "F7_OFF_1")
video.toggle_crt()
term.key_press(keys.F7)
sys.wait_frames(60)
phase(true, "F7_ON_2")
video.toggle_crt()
term.key_press(keys.F7)
sys.wait_frames(60)
phase(false, "F7_OFF_3")
video.toggle_crt()
term.key_press(keys.F7)
sys.wait_frames(60)
phase(true, "F7_ON_4")

dbg.open()
for _, line in ipairs(dbg.command_output("r")) do
    sys.print("CRT_ROTOZOOMER_IEMON " .. tostring(line.text or line))
end
dbg.close()

rec.stop()
sys.print("CRT_ROTOZOOMER_CAPTURE=" .. capture)
sys.exit(0)
