-- CRT-Guest-Advanced end-to-end acceptance fixture.
-- Keep this script beside the launched demo binary. For example:
--   IE_NO_IPC=1 go run . -script sdk/examples/prebuilt/diag_crt_guest_advanced.ies \
--     sdk/examples/prebuilt/rotating_cube_copper_68k.ie68
--
-- start_screen reads after the Ebiten presentation pipeline. video.frame_hash
-- intentionally identifies the guest compositor workload before CRT, while
-- the MP4 is the final Guest-Advanced artefact for visual review.
local capture = "diag_crt_guest_advanced.mp4"

rec.start_screen(capture)
sys.wait_frames(60)

local function require_crt(expected, phase)
    local actual = video.is_crt_enabled()
    if actual ~= expected then
        error(string.format("CRT state at %s = %s, want %s", phase, tostring(actual), tostring(expected)))
    end
    sys.print(string.format("CRT_GUEST_ADVANCED_%s enabled=%s compositor_hash=0x%X", phase, tostring(actual), video.frame_hash()))
    rec.screenshot("diag_crt_guest_advanced_" .. string.lower(phase) .. ".png")
    rec.screenshot_screen("diag_crt_guest_advanced_screen_" .. string.lower(phase) .. ".png")
end

-- This is the host F7 action, not a guest scancode. Exercise the exact
-- presentation transition four times so the final phase returns to CRT on.
require_crt(true, "INITIAL")
video.toggle_crt()
sys.wait_frames(60)
require_crt(false, "F7_OFF_1")
video.toggle_crt()
sys.wait_frames(60)
require_crt(true, "F7_ON_2")
video.toggle_crt()
sys.wait_frames(60)
require_crt(false, "F7_OFF_3")
video.toggle_crt()
sys.wait_frames(60)
require_crt(true, "F7_ON_4")

local w, h = video.get_dimensions()
local frame_hash = video.frame_hash()
local frame_ms = sys.frame_time()
sys.print(string.format("CRT_GUEST_ADVANCED_FRAME size=%dx%d compositor_hash=0x%X frame_ms=%.3f", w, h, frame_hash, frame_ms))

dbg.open()
for _, line in ipairs(dbg.command_output("r")) do
    sys.print("CRT_GUEST_ADVANCED_IEMON " .. tostring(line.text or line))
end
dbg.close()

rec.stop()
sys.print("CRT_GUEST_ADVANCED_CAPTURE=" .. capture)
sys.exit(0)
