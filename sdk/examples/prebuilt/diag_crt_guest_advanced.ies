-- CRT-Guest-Advanced end-to-end acceptance fixture.
-- Keep this script beside the launched demo binary. For example:
--   IE_NO_IPC=1 go run . -script sdk/examples/prebuilt/diag_crt_guest_advanced.ies \
--     sdk/examples/prebuilt/rotating_cube_copper_68k.ie68
--
-- start_screen reads after the Ebiten presentation pipeline. video.frame_hash
-- intentionally identifies the guest compositor workload before CRT, while
-- the MP4 is the final Guest-Advanced artefact for visual review.
local capture = "diag_crt_guest_advanced.mp4"

rec.start_screen(capture)
sys.wait_frames(180)

local w, h = video.get_dimensions()
local frame_hash = video.frame_hash()
local frame_ms = sys.frame_time()
sys.print(string.format("CRT_GUEST_ADVANCED_FRAME size=%dx%d compositor_hash=0x%X frame_ms=%.3f", w, h, frame_hash, frame_ms))

dbg.open()
for _, line in ipairs(dbg.command_output("r")) do
    sys.print("CRT_GUEST_ADVANCED_IEMON " .. tostring(line.text or line))
end
dbg.close()

rec.stop()
sys.print("CRT_GUEST_ADVANCED_CAPTURE=" .. capture)
sys.exit(0)
