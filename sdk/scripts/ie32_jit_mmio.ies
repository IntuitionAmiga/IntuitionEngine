-- Bounded MMIO-poll diagnostic. The shipped rotozoomer polls video state;
-- capture helper provenance without performing raw RAM access while running.
cpu.load_stopped("sdk/examples/prebuilt/rotozoomer.iex")
sys.print("ie32-mmio before", cpu.execution_mode(), cpu.jit_stats())
cpu.start()
sys.wait_frames(2)
cpu.stop()
sys.print("ie32-mmio after", cpu.execution_mode(), cpu.jit_stats())
